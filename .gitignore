# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
/.open-next/
/.wrangler/
# .dev.vars 含 secret,不進版控
.dev.vars
# wrangler 產生的型別檔,build/typegen 時重生
cloudflare-env.d.ts

# commercial-only licensing 實作(src/licensing/index.ts 靠 build-time stub
# 保證這個路徑永遠有東西可打包,見 scripts/ensure-licensing-stub.mjs)
src/licensing/verify.local.ts
dist-ext/

# markdown:預設進版控 —— 公開 repo 需要 README / DEPLOY 這類文件,
# 之前的 `*.md` 全域忽略讓 GitHub 上的 repo 一份 markdown 都沒有。
#
# 內部 spec 與 audit 紀錄不公開:docs/ 下的 markdown 預設忽略。
# 要公開某一份就在下面加一行 allowlist。
docs/*.md
# README 指名這份為架構真相來源,所以它必須進得了 clone。
!docs/core-v2-architecture.md

# AI coding agent 的本機設定/快取 —— 純屬個人工作環境,不進公開 repo。
# (取消 `*.md` 全域忽略後,這些目錄裡的 markdown 會整包冒出來。)
.claude/
.codex/
.cursor/
.opencode/
.pi/
.mcp.json
opencode.json
