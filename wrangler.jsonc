{
  // [site] 這個檔預期逐站不同 —— worker 名稱、D1/R2 的 id 本來就每個站一組。
  // `sz-ws-cms setup` 會自動填入下面的 database_id(只改那幾個值,註解與排版原樣保留)。
  //
  // 但 "main" 與 "triggers" 是 core 的東西:前者指向 custom-worker.ts(cron 接線的
  // 唯一入口),後者是排程頻率。動它們之前先讀 custom-worker.ts 的說明。
  "$schema": "node_modules/wrangler/config-schema.json",
  // main 指向 custom-worker.ts,而不是 OpenNext 直接產出的 .open-next/worker.js ——
  // 那個產出物只有 `fetch`,沒有 `scheduled`。custom-worker.ts 原樣 re-export 它的
  // fetch 與 Durable Object class,只多掛一個 scheduled handler(cron extension 的
  // tick)。@opennextjs/cloudflare 的 CLI 不讀也不覆寫這個欄位,產出物一個 byte 都沒動。
  "main": "custom-worker.ts",
  // 新 clone 先由 `sz-ws-cms setup --site-slug <slug>` 原子寫入這組名稱;不得在同帳號共用。
  "name": "cms",
  // 分鐘級準時排程。tick 實作見 extensions/cron/scheduled.ts:cron extension 未安裝
  // 或未設 signing secret 時,handler 安靜 no-op(core 的 lazy sweep 仍是保底)。
  // 要更省可調成 "*/5 * * * *";publish-due 的 WHERE 子句冪等,與 lazy sweep 併發無害。
  "triggers": { "crons": ["* * * * *"] },
  // ⚠️ 這個日期不可以往回調。2025-08-15 是 workerd 原生 node:http / node:https
  // **client** 成為預設的那一天(enable_nodejs_http_modules)。比它舊的話,
  // OpenNext 在**建置時**就會把 node:https 別名到 unenv 的空殼,任何走
  // https.request 的相依程式庫都會在執行期拿到:
  //
  //   Error: [unenv] https.request is not implemented yet!
  //
  // 實際踩到的是 @sentry/nextjs —— 它在 server 側載入 Node SDK,傳輸層走
  // https.request。症狀極難查:captureException 成功、SDK 說 initialized、
  // 後台狀態頁說「送出中」,但收集端一筆都收不到。只有 CMS_ERROR_DEBUG=1 +
  // `wrangler tail` 才看得到真正的錯誤。
  //
  // ⚠️ 加 "enable_nodejs_http_modules" 到 compatibility_flags **沒有用**(實測過)。
  // 別名是建置期綁定的,執行期的 flag 改不動已經打包好的 import 解析。
  // 唯一有效的是這個日期本身。
  //
  // 調整這個日期會一次打開該期間**所有**的行為變更,不只是 http ——
  // 動它之後要重跑完整測試,並確認 vitest.config.ts 的 compatibilityDate 同步。
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // service 必須與 name 同步,否則 cron 的簽名 self-call 會打到別的 Worker。
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cms" }],
  // setup 用此值確認命名已由 slug 衍生;空字串代表尚未設定的新 scaffold。
  "vars": { "CMS_SITE_SLUG": "" },
  "images": { "binding": "IMAGES" },
  "d1_databases": [
    // database_id 為佔位值:本環境無 Cloudflare 帳號,無法 `wrangler d1 create`。
    // `cms deploy` / `cms setup` 會建好資料庫、把真實 UUID 與 slug 化的名稱一起寫回這裡。
    { "binding": "DB", "database_name": "cms-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
    // tag cache(OpenNext d1NextTagCache):on-demand revalidateTag 的 tag 記錄。
    // **這是兩個 binding,不是兩個資料庫** —— CLI 預設把它指向上面那一個(名稱會一起
    // 改寫成 cms-<slug>-db),理由是 Free plan 每帳號只有 10 個 D1,而這裡只存
    // tag→revalidatedAt。要各自獨立就用 `cms setup --separate-tag-cache`;手動接的話,
    // 兩個佔位值填同一個 id 即可,除非你自己另外建了一個資料庫。
    // `revalidations` 表不用自己建:`opennextjs-cloudflare deploy` 會先跑
    // populate-cache,由它 CREATE TABLE IF NOT EXISTS(表名與 src/lib/schema.ts 不衝突,
    // 這是共用同一個資料庫安全的原因;schema 屬於 OpenNext,v1.19 加過 stale/expire
    // 兩欄 —— 所以不要手抄一份進版控,會漂移)。見 DEPLOY.md。
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "cms-tag-cache", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "cms-storage" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cms-next-cache" }
  ]
}
