{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "postinstall": "node scripts/ensure-licensing-stub.mjs",
    "predev": "node scripts/ensure-licensing-stub.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-licensing-stub.mjs",
    "build": "next build",
    "prepreview": "node scripts/ensure-licensing-stub.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "predeploy": "node scripts/ensure-licensing-stub.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cms-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cms-db --remote",
    "lint": "eslint",
    "pretest": "node scripts/ensure-licensing-stub.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "gen:schema": "node scripts/gen-manifest-schema.mts",
    "gen:schema:check": "node scripts/gen-manifest-schema.mts --check",
    "ext:pack": "node scripts/ext-pack.mjs",
    "ext:add": "node scripts/ext-add.mjs",
    "cli:build": "tsc -p cli/tsconfig.json",
    "cli:typecheck": "tsc -p cli/tsconfig.json --noEmit",
    "test:cli": "vitest run --config vitest.cli.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@heroicons/react": "^2.2.0",
    "@number-flow/react": "^0.6.1",
    "@shadcn/react": "^0.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tiptap/core": "2.27.2",
    "@tiptap/extension-image": "^2",
    "@tiptap/extension-link": "^2",
    "@tiptap/html": "^2",
    "@tiptap/pm": "^2",
    "@tiptap/react": "^2",
    "@tiptap/starter-kit": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "nanoid": "^5.1.16",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-aria-components": "^1.19.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "torph": "^0.0.9",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "4.86.0"
  }
}
