{
  "name": "@sz-ws/cms",
  "version": "0.2.0",
  "description": "CLI for sz.ws CMS — `setup` wires the repo to your Cloudflare account, `add` installs code extensions.",
  "type": "module",
  "bin": {
    "cms": "dist/cli.js",
    "sz-ws-cms": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sz.ws",
    "sz-ws",
    "cms",
    "cli",
    "cloudflare",
    "workers",
    "d1"
  ],
  "author": "Suko Kuo (@kuosuko)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sz-ws/cms.git",
    "directory": "cli"
  },
  "homepage": "https://sz.ws",
  "bugs": {
    "url": "https://github.com/sz-ws/cms/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
